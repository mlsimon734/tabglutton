# AMO (addons.mozilla.org) signing. `bun run sign`, `sign:listed`, and `sign:dev` read
# these and nothing else does.
WEB_EXT_API_KEY=user:...
WEB_EXT_API_SECRET=...

# Chrome Web Store publishing (`bun run publish:chrome`). Publisher id: Developer
# Dashboard -> PUBLISHER -> Settings. The rest come from a Google Cloud OAuth client of
# type "Desktop app"; run `bun run cws:auth` once to mint the refresh token. Setup in
# docs/STORE.md section 7.
CWS_PUBLISHER_ID=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Agent bridge. Generate in Tabglutton's options page (Settings → Agent bridge →
# Generate) and paste here; .mcp.json reads it, so no token is ever committed.
TABGLUTTON_TOKEN=
