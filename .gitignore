node_modules/
web-ext-artifacts/
dist/
dist-firefox/
dist-chrome/
.DS_Store
*.log
# Dev browser profiles. Wildcard rather than one line per profile: these carry
# the bridge token in extension storage, and a profile added later must not be
# one `git add -A` away from committing it.
.dev-profile*/
# Personal, not shared. Everything else under .claude/ is tracked on purpose:
# repo-level settings.json and .claude/skills/ are the only agent config that
# reaches a cloud session (~/.claude/ does not), so a skill left ignored here is
# a skill that exists locally and nowhere else.
.claude/settings.local.json
.claude/.cc-writes/
skills-lock.json
.env
.env.signing

# Local-only Chrome verification harness (not part of the build)
scratch-chrome/
